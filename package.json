{
  "name": "tool-forge-template",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build:wasm": "bash scripts/build-wasm.sh",
    "build": "pnpm build:wasm && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "pack:tool": "pnpm build && tsx scripts/pack-tool.ts",
    "pack:store": "pnpm pack:tool && tsx scripts/pack-store.ts",
    "pack:source": "bash scripts/pack-source-zip.sh",
    "install:host": "bash scripts/install-to-host.sh",
    "smoke:host": "node scripts/smoke-host.mjs"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.0.5",
    "vue-tsc": "^2.2.0"
  }
}
